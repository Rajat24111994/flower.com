# Supply these through the server's environment or secret manager, never frontend files.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
CRON_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
PUBLIC_APP_URL=https://your-store.example
# Optional exact IP addresses of trusted reverse proxies, comma-separated.
# Leave empty when Kestrel receives requests directly. Never trust arbitrary forwarded headers.
TRUSTED_PROXY_IPS=
ASPNETCORE_HTTP_PORTS=8080
