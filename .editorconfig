# Quy ước định dạng chung cho cả nhóm. VS Code cần cài tiện ích "EditorConfig for VS Code".
# Chỉ áp dụng cho phần mới gõ, không tự định dạng lại code cũ.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
