{
    // Ẩn những thư mục, file sinh tự động để cây thư mục gọn hơn
    "files.exclude": {
        "**/node_modules": true,
        "**/coverage": true,
        "**/test-results": true,
        "**/playwright-report": true,
        "**/*.log": true
    },
    // Không tìm kiếm trong thư viện và file sinh tự động
    "search.exclude": {
        "**/node_modules": true,
        "**/coverage": true,
        "**/package-lock.json": true
    },
    // Thư mục xếp trước, file xếp sau, cùng loại thì theo tên
    "explorer.sortOrder": "foldersNestsFiles",
    // Thu gọn thư mục chỉ có một thư mục con (ví dụ api/admin)
    "explorer.compactFolders": false
}
