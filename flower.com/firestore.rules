rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The claim alone stays valid until the ID token expires (up to an hour); the adminRoles
    // document is deleted the moment an Owner removes admin access (api/owner/users.js).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }

    match /products/{productId} {
      function validFields(keys) {
        let data = request.resource.data;
        return (!keys.hasAny(['title']) || (data.title is string && data.title.size() <= 120 && data.title.matches('.*\\S.*')))
          && (!keys.hasAny(['price']) || (data.price is int && data.price >= 1000))
          && (!keys.hasAny(['description']) || (data.description is string && data.description.size() > 0 && data.description.size() <= 1000))
          && (!keys.hasAny(['image']) || (data.image is string && data.image.size() > 0))
          && (!keys.hasAny(['category']) || data.category is string)
          && (!keys.hasAny(['images']) || (data.images is list && data.images.size() <= 8))
          && (!keys.hasAny(['saleType']) || data.saleType in ['flower', 'ready_made'])
          && (!keys.hasAny(['priceUpdatedAt']) || (data.priceUpdatedAt is string && data.priceUpdatedAt.matches('^\\d{4}-\\d{2}-\\d{2}$')));
      }
      allow get, list: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'price', 'quantity', 'image', 'description'])
        && validFields(request.resource.data.keys())
        && request.resource.data.quantity is int && request.resource.data.quantity >= 0
        && request.resource.data.get('status', 'active') in ['active', 'hidden'];
      // Validate changed fields so legacy records can still receive stock/status corrections.
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'priceUpdatedAt', 'priceChangedAt', 'priceUpdatedBy', 'priceUpdatedByEmail'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['price'])
          || (resource.data.get('saleType', 'ready_made') != 'flower'
            && request.resource.data.get('saleType', resource.data.get('saleType', 'ready_made')) != 'flower'))
        && validFields(request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.quantity is int && request.resource.data.quantity >= 0
        && request.resource.data.get('status', 'active') in ['active', 'hidden'];
      allow delete: if isAdmin();
    }

    match /metadata/{metadataId} {
      allow get: if isAdmin() || metadataId in ['activePromotions', 'storeCategories'];
      allow list, create, update, delete: if isAdmin();
    }

    // Customers review through /api/orders (action "review"), which checks that the order is
    // theirs and delivered and allows one review per order.
    match /reviews/{reviewId} {
      allow get, list: if resource.data.get('moderationStatus', 'pending') == 'approved'
        || isAdmin()
        || (request.auth != null && resource.data.get('authorUid', '') == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reply', 'completedAt', 'moderationStatus', 'moderationReason', 'moderatedAt', 'moderatedBy'
        ])
        && request.resource.data.get('reply', '') is string
        && request.resource.data.get('reply', '').size() <= 1000
        && request.resource.data.get('moderationReason', '') is string
        && request.resource.data.get('moderationReason', '').size() <= 500
        && request.resource.data.get('moderationStatus', 'pending') in ['pending', 'approved', 'hidden']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationStatus'])
          || (request.resource.data.moderatedBy == request.auth.uid && request.resource.data.moderatedAt == request.time));
    }

    // Image bytes are immutable; the API checks the parent review's current visibility.
    match /reviewImages/{photoId} {
      allow read, write: if false;
    }

    // Product photos are saved and served only by /api/product-images (admin upload, public read).
    match /productImages/{photoId} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      function canonicalOrderStatus(status) {
        return status in ['Đặt hàng', 'Đã nhận đơn'] ? 'Chờ xác nhận'
          : status == 'Đã vận chuyển' ? 'Đang giao'
          : status in ['Hoàn thành', 'Hoàn thành chuyến'] ? 'Đã giao'
          : status in ['Giao hàng thất bại', 'Từ chối đơn hàng'] ? 'Đã hủy'
          : status;
      }
      function validOrderStatusTransition() {
        let previousRaw = resource.data.get('status', 'Chờ xác nhận');
        let nextRaw = request.resource.data.get('status', previousRaw);
        let previous = canonicalOrderStatus(previousRaw);
        let next = canonicalOrderStatus(nextRaw);
        return nextRaw == previousRaw
          || (nextRaw in ['Chờ xác nhận', 'Đang chuẩn bị', 'Đang giao', 'Đã giao', 'Đã hủy']
            && (previous == next
              || (previous == 'Chờ xác nhận' && next in ['Đang chuẩn bị', 'Đã hủy'])
              || (previous == 'Đang chuẩn bị' && next in ['Đang giao', 'Đã hủy'])
              || (previous == 'Đang giao' && next in ['Đã giao', 'Đã hủy'])
              || (previous == 'Đã giao' && next == 'Đã hủy')
              || (previous == 'Đã hủy' && next == 'Chờ xác nhận')));
      }
      function allowedAdminOrderUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let codDeliveryPayment = request.resource.data.get('paymentMethod', '') == 'cod'
          && request.resource.data.get('status', '') == 'Đã giao'
          && request.resource.data.get('paymentStatus', '') == 'Đã thanh toán';
        let restoreUnpaidQrOrder = request.resource.data.get('paymentMethod', '') == 'qr'
          && resource.data.get('paymentMethod', '') == 'qr'
          && resource.data.get('status', '') == 'Đã hủy'
          && request.resource.data.get('status', '') == 'Chờ xác nhận'
          && request.resource.data.get('paymentStatus', '') == 'Chờ xác minh thanh toán'
          && resource.data.get('paymentVerified', false) == false;
        return changed.hasOnly([
          'status', 'currentLocation', 'estimatedDelivery', 'trackingUpdatedAt', 'trackingHistory',
          'paymentStatus', 'paidAt', 'salesCounted', 'inventoryState', 'inventoryReserved',
          'reservationExpiresAt', 'reservationExpiredAt'
        ])
          && validOrderStatusTransition()
          && (!changed.hasAny(['paymentStatus']) || codDeliveryPayment || restoreUnpaidQrOrder)
          && (!changed.hasAny(['paidAt']) || (codDeliveryPayment && request.resource.data.paidAt is string));
      }
      allow create: if false;
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && allowedAdminOrderUpdate();
      allow delete: if isAdmin();
    }

    // Each customer can access only their own bounded, non-authoritative shopping snapshot.
    match /shoppingCarts/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validShoppingData() {
        return request.resource.data.keys().hasOnly(['cart', 'wish'])
          && request.resource.data.keys().hasAll(['cart', 'wish'])
          && request.resource.data.cart is list
          && request.resource.data.cart.size() <= 100
          && request.resource.data.wish is list
          && request.resource.data.wish.size() <= 100;
      }
      allow get: if isOwner();
      allow list: if false;
      allow create, update: if isOwner() && validShoppingData();
      allow delete: if isOwner();
    }

    // Administrative audit entries are written through the trusted backend only.
    match /adminAudit/{entryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
