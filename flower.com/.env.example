# Copy to .env only in a non-synced local folder; fill only local development values.
# Never put real credentials in this template or commit/share/sync the local .env file.

# Local frontend + API server (npm run dev).
PORT=3000
AUTH_MODE=local

# Firebase Admin: local command-line scripts can use gcloud ADC instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=web-ban-hoa-9fe0b
GOOGLE_CLOUD_PROJECT=web-ban-hoa-9fe0b

# Optional Firebase mode (AUTH_MODE=firebase); not needed for self-created local accounts.
# The public key must match js/core/firebase-config.js.
# The server key must be a DIFFERENT, private key, never bundled into the website.
# Restrict public keys at API-method level before enabling login; see docs/login-protection.md.
FIREBASE_AUTH_PUBLIC_API_KEY=
FIREBASE_AUTH_SERVER_API_KEY=

# VNPay server configuration. Use sandbox credentials during development.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
PUBLIC_APP_URL=https://your-store.example

# Optional local-only server secret. Keep production secrets in the hosting secret store.
CRON_SECRET=
