# Copy to .env only in a non-synced local folder; fill only local development values.
# Never put real credentials in this template or commit/share/sync the local .env file.

# Firebase Admin: local command-line scripts can use gcloud ADC instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=web-ban-hoa-9fe0b
GOOGLE_CLOUD_PROJECT=web-ban-hoa-9fe0b

# VNPay server configuration. Use sandbox credentials during development.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
PUBLIC_APP_URL=https://your-store.example

# Optional local-only server secret. Keep production secrets in the hosting secret store.
CRON_SECRET=
