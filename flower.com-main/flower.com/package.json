{
    "name":  "flowerflow-web",
    "private":  true,
    "engines":  {
                    "node":  "24.x"
                },
    "scripts":  {
                    "set-admin":  "node scripts/set-admin-claim.js",
                    "set-owner":  "node scripts/set-owner-claim.js",
                    "sync-admin-roles":  "node scripts/sync-admin-roles.js",
                    "setup-firestore":  "node scripts/setup-firestore.js",
                    "test": "node --test \"../tests/*.test.js\"",
                    "test:coverage": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-exclude=\"../tests/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"../tests/*.test.js\"",
                    "smoke": "node scripts/smoke-test.js",
                    "test:e2e": "playwright test",
                    "test:e2e:emulator": "firebase emulators:exec --project web-ban-hoa-9fe0b --only auth,firestore \"npm run test:e2e\""
                },
    "dependencies":  {
                         "firebase-admin":  "^13.0.0"
                     },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "firebase-tools": "^15.34.1"
    }
}
