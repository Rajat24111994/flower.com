<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Content Include="../../../flower.com/*.html;../../../flower.com/flower.json;../../../flower.com/favicon.svg;../../../flower.com/robots.txt;../../../flower.com/sitemap.xml;../../../flower.com/vercel.json" Link="frontend/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../flower.com/js/**/*.js" Link="frontend/js/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../flower.com/css/**/*.css" Link="frontend/css/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../flower.com/images/**/*" Exclude="../../../flower.com/images/**/*.json;../../../flower.com/images/**/.*;../../../flower.com/images/**/*.env*;../../../flower.com/images/**/*.key;../../../flower.com/images/**/*.pem" Link="frontend/images/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
